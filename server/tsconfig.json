{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,

    /* Linting — mirrors tsconfig.app.json */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["./**/*.ts", "../cli/**/*.ts", "../frontend/src/types.ts"],
  // Dev-only tool that imports the browser registry; covered by check:cli.
  "exclude": ["../cli/check-registry.ts"]
}
