{
  "name": "workflow-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:agent": "python -m uvicorn src.main:app --reload --reload-dir src --reload-dir config --reload-include models.json --reload-include agent_config.yaml --port 8000",
    "dev:all": "concurrently -n web,api,agent -c blue,green,yellow \"npm run dev\" \"npm run dev:server\" \"npm run dev:agent\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "run:wf": "tsx --env-file-if-exists=.env cli/run.ts",
    "check:cli": "tsc --noEmit -p cli/tsconfig.json",
    "check:server": "tsc --noEmit -p server/tsconfig.json",
    "check:registry": "tsx cli/check-registry.ts",
    "test:agent": "python -m pytest tests/",
    "test:nodes": "tsx --test tests/nodes.test.ts",
    "test:server": "tsx --test tests/server.test.ts",
    "ingest": "tsx --env-file-if-exists=.env cli/ingest.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.59.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
