{
  "default_model": "groq:openai/gpt-oss-20b",
  "providers": {
    "groq": {
      "label": "Groq",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "reasoning_effort": true,
      "models": [
        { "id": "openai/gpt-oss-20b", "label": "GPT-OSS 20B" },
        { "id": "openai/gpt-oss-120b", "label": "GPT-OSS 120B" },
        { "id": "qwen/qwen3.8-27b", "label": "Qwen3.8 27B" }
      ]
    },
    "openai": {
      "label": "OpenAI",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        { "id": "gpt-4o-mini", "label": "GPT-4o mini" },
        { "id": "gpt-4o", "label": "GPT-4o" }
      ]
    },
    "gemini": {
      "label": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "api_key_env": "GEMINI_API_KEY",
      "json_object_mode": false,
      "models": [
        { "id": "gemini-3.8-flash", "label": "Gemini 3.8 Flash" },
        { "id": "gemini-3.5-flash-lite", "label": "Gemini 3.5 Flash-Lite" }
      ]
    }
  },
  "default_embedding_model": "gemini:gemini-embedding-001",
  "embedding_models": {
    "gemini": [
      { "id": "gemini-embedding-001", "label": "gemini-embedding-001 (3072)", "dimensions": 3072 }
    ],
    "openai": [
      { "id": "text-embedding-3-small", "label": "text-embedding-3-small (1536)", "dimensions": 1536 },
      { "id": "text-embedding-3-large", "label": "text-embedding-3-large (3072)", "dimensions": 3072 }
    ]
  }
}
