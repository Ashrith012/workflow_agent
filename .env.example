# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Loaded by `npm run run:wf`, `npm run dev:server` and `npm run dev:all`
# (Node's --env-file-if-exists). Variables already set in your shell win.
# Restart the API after editing — tsx watch does not reload .env.

# OpenAI nodes in live mode
OPENAI_API_KEY=

# Google Gemini — chat models and the default embedding model (gemini-embedding-2).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq nodes in live mode — https://console.groq.com/keys
GROQ_API_KEY=

# Your own LLM: any OpenAI-compatible server (Ollama, vLLM, TGI). No API key needed.
# Overrides the "selfhosted" provider's URL in config/models.json — set this when the
# endpoint moves (a trycloudflare tunnel gets a new URL every restart).
# Must end at the OpenAI-compatible base, usually /v1.
SELFHOSTED_BASE_URL=

# Python agent service (src/main.py) that runs AI Agent and SharePoint nodes; `npm run dev:agent`.
# It reads GROQ_API_KEY / OPENAI_API_KEY and the SHAREPOINT_* values from this file too.
AGENT_SERVICE_URL=http://localhost:8000

# SharePoint nodes in live mode — an Azure AD (Entra ID) app registration with a client secret
# and the Microsoft Graph application permission Sites.Read.All (Sites.ReadWrite.All for uploadFile),
# admin-consented. See docs/workflow-canvas.md#sharepoint-node.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Used when a SharePoint node leaves Site URL blank, e.g. https://contoso.sharepoint.com/sites/Marketing
SHAREPOINT_SITE_URL=

# ---- Manzil / published workflows ----

# PostgreSQL for users, published workflows, runs and chat history.
# Blank: an embedded PGlite database in .data/pglite (local development only).
DATABASE_URL=
# bcrypt work factor for password hashes (10-15, default 10). Raising it re-hashes each
# password on that user's next sign-in; existing hashes keep working either way.
BCRYPT_ROUNDS=

# Signs session cookies. Required in production; blank in development uses a random per-start secret.
JWT_SECRET=
# First administrator, created on start when the users table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# live (default) or mock — mode for workflows run from the end-user app.
APP_RUN_MODE=live

# Qdrant (Qdrant Search / Qdrant Upsert nodes)
QDRANT_URL=
QDRANT_API_KEY=

# SharePoint MCP server, streamable HTTP endpoint (SharePoint MCP node), e.g. https://mcp.example.com/mcp
SHAREPOINT_MCP_URL=
# Sent as "Authorization: Bearer <token>" when set.
SHAREPOINT_MCP_TOKEN=
